# Static web client for staging. The committed package-lock.json is out of sync with package.json, so the
# build resolves from package.json like CI does (not byte-reproducible; see READINESS.md).
FROM node:20-bookworm-slim AS build
ARG VITE_API_BASE_URL
RUN test -n "$VITE_API_BASE_URL" || (echo "VITE_API_BASE_URL build argument is required" >&2; exit 1)
WORKDIR /web
COPY Front-End/package.json ./
RUN npm install --no-package-lock --no-audit --no-fund
COPY Front-End/ ./
RUN rm -f package-lock.json && VITE_API_BASE_URL="$VITE_API_BASE_URL" npx vite build

FROM nginx:1.27-alpine
COPY deploy/teia-staging/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
