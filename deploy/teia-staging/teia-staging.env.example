# TEIA staging environment. Copy to teia-staging.env on the server (chmod 600, never committed) and fill the
# blank values from the owner's secret manager. Staging-only values: never reuse production or shared .env
# credentials. ./validate.sh refuses blanks, placeholders and weak secrets without printing any value.
# Variable names match src/core/settings/config.py.

# --- Proposed temporary hosts (UNVERIFIED until DNS resolves and Caddy has issued certificates) ---------
FRONTEND_URL=https://teia.65-108-244-83.sslip.io
CORS_ALLOW_ORIGINS=["https://teia.65-108-244-83.sslip.io"]
# Build argument for the web image (where the browser sends API requests).
TEIA_WEB_API_BASE_URL=https://teia-api.65-108-244-83.sslip.io/api/v1

# --- Authentication -----------------------------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`. The API refuses to start otherwise.
SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# --- Postgres (teia-staging-db; not published) ----------------------------------------------------------
POSTGRES_DB=teia_staging
POSTGRES_USER=teia_staging
POSTGRES_PASSWORD=

# --- Qdrant (teia-staging-qdrant; not published) --------------------------------------------------------
QDRANT_API_KEY=
QDRANT_COLLECTION=teia_staging_documents
# Must equal the embedding model's dimension (text-embedding-3-large: 3072, text-embedding-3-small: 1536).
QDRANT_VECTOR_SIZE=3072
QDRANT_SUPPRESS_INSECURE_WARNING=true

# --- Object storage (teia-staging-objects, S3-compatible; not published) --------------------------------
# These are the credentials the SeaweedFS S3 gateway is created with; any random values (staging only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=teia-staging-documents

# --- AI provider (staging-only credential) --------------------------------------------------------------
# A spending limit is set in the provider's console; nothing in this repository enforces or verifies it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
DEFAULT_ALLOWED_MODELS=["gpt-5-nano"]
# Web search needs a Tavily key; off for the pilot unless the owner provides a staging key.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# --- Email (staging-only SMTP; invitations are email-only) ----------------------------------------------
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=TEIA AI (staging)

# --- Limits ---------------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
PROCESSING_TIMEOUT_SECONDS=300
PROVIDER_STREAM_IDLE_TIMEOUT_SECONDS=120
QUOTA_UNKNOWN_USAGE_TOKENS=4000
ENABLE_METRICS=false
